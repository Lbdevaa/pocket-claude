# Скопируй в .env и заполни. Сам .env в git не попадает — см. .gitignore.

# Обязательные

TG_TOKEN=
# Токен бота от @BotFather: /newbot, строка вида 1234567890:AA...

ANTHROPIC_API_KEY=
# Ключ с console.anthropic.com -> API Keys. Нужен положительный баланс:
# подписка Claude.ai для API не подходит, это отдельная оплата.

ALLOWED_USER_IDS=123456789
# Твой Telegram user id — узнать у @userinfobot. Несколько — через запятую.
# Всем остальным бот отвечает отказом.

# Необязательные — можно не трогать

MODEL=claude-opus-5
# Альтернативы: claude-sonnet-5 (дешевле), claude-haiku-4-5 (ещё дешевле и проще)

MAX_TOKENS=16000
# Потолок длины одного ответа модели

HISTORY_LIMIT=30
# Сколько последних сообщений чата помним и отправляем в API

PARSE_MODE=Markdown
# Разметка ответов: Markdown | MarkdownV2 | HTML | none
# При ошибке разбора бот всё равно переотправит сообщение без разметки

SYSTEM_PROMPT=Ты — личный ассистент в Telegram. Отвечай по-русски. Ответ читают с телефона: без вступлений и финальных резюме, короткими абзацами. Таблицы Telegram не отображает — вместо них списки. Если вопрос допускает разные толкования, задай один уточняющий вопрос, а не отвечай сразу на все варианты.
# Манера ответа. Должен быть одной строкой — переносы .env не поймёт.
